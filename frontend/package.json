{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "test:ai": "node --experimental-vm-modules node_modules/.bin/jest --config=tests-AI/jest.config.js --no-coverage --runInBand",
    "test:ai:watch": "node --experimental-vm-modules node_modules/.bin/jest --config=tests-AI/jest.config.js --no-coverage --runInBand --watch",
    "test:deepeval": "cd deepeval_heuristic && python -m pytest -v",
    "test:deepeval:correctness": "cd deepeval_heuristic && python -m pytest test_correctness.py -v",
    "test:deepeval:completion": "cd deepeval_heuristic && python -m pytest test_task_completion.py -v",
    "test:deepeval:toxicity": "cd deepeval_heuristic && python -m pytest test_toxicity.py -v",
    "test:deepeval:rag": "cd deepeval_heuristic && python -m pytest test_rag_evaluation.py -v",
    "lighthouse:public": "esbuild src/lighthouse/run-audits.ts --bundle --platform=node --format=cjs --external:lighthouse --external:chrome-launcher --external:playwright --outfile=dist/lighthouse/run-audits.cjs && node dist/lighthouse/run-audits.cjs",
    "lighthouse:protected": "esbuild src/lighthouse/run-protected.ts --bundle --platform=node --format=cjs --external:lighthouse --external:chrome-launcher --external:playwright --external:puppeteer --outfile=dist/lighthouse/run-protected.cjs && node dist/lighthouse/run-protected.cjs",
    "lighthouse:all": "npm run lighthouse:public && npm run lighthouse:protected",
    "test:bdd": "TS_NODE_PROJECT=tests/bdd/support/tsconfig.bdd.json TS_NODE_TRANSPILE_ONLY=true TS_NODE_FILES=true node --require ts-node/register node_modules/.bin/cucumber-js --require tests/bdd/support/world.ts --require tests/bdd/support/hooks.ts --require 'tests/bdd/steps/**/*.ts' --format progress-bar 'tests/bdd/features/**/*.feature'",
    "test:bdd:auth": "TS_NODE_PROJECT=tests/bdd/support/tsconfig.bdd.json TS_NODE_TRANSPILE_ONLY=true TS_NODE_FILES=true node --require ts-node/register node_modules/.bin/cucumber-js --require tests/bdd/support/world.ts --require tests/bdd/support/hooks.ts --require 'tests/bdd/steps/auth/**/*.ts' --format progress-bar 'tests/bdd/features/auth/**/*.feature'",
    "test:bdd:watch": "cucumber-js --config cucumber.config.ts --watch",
    "test:bdd:report": "serenity-bdd run --features src/tests-bdd/features"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.5.0",
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.60.0",
    "@serenity-js/assertions": "^3.43.3",
    "@serenity-js/core": "^3.43.3",
    "@serenity-js/cucumber": "^3.43.3",
    "@serenity-js/playwright": "^3.43.3",
    "@serenity-js/web": "^3.43.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chai": "^4.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.0",
    "chai": "^4.3.8",
    "chrome-launcher": "^1.2.1",
    "chromium": "^3.0.3",
    "cucumber": "^6.0.7",
    "cypress": "^15.16.0",
    "cypress-axe": "^1.7.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^11.4.0",
    "playwright": "^1.60.0",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "web-streams-polyfill": "^4.3.0",
    "zod": "^4.4.3"
  }
}
