{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "@cucumber/cucumber"
        ]
    },
    "include": [
        "../**/*.ts"
    ],
    "exclude": [
        "**/*.feature",
        "**/node_modules",
        "../../../src/**",
        "../../../app/**",
        "../../../pages/**",
        "../../../components/**"
    ]
}